    {
      "id": "bug-blackscreen-variant",
      "timestamp": "2026-07-11T15:40:00.000Z",
      "error_message": "BLACK SCREEN. Godot: 'Parse Error: The variable type is being inferred from a Variant value ... (Warning treated as error.)' at battle_view.gd:862 -> 'Failed to load script ... Parse error' -> scene never instantiates.",
      "file": "scripts/combat/battle_view.gd",
      "root_cause": "Project treats GDScript warnings as errors; `var n := {...}.get(rar, 3)` infers Variant -> fatal parse error kills the whole script. gdtoolkit does NOT catch this; only Godot does.",
      "fix": "Annotate type instead of inferring from Variant: `var n: int = {...}.get(rar, 3)`. Never `:=` from Variant (Dictionary.get / dict-index / untyped). Verify with a real Godot run, not just gdtoolkit.",
      "tags": [
        "godot",
        "gdscript",
        "warnings-as-errors",
        "variant-inference",
        "black-screen",
        "parse-error"
      ],
      "related_bugs": [],
